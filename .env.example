# Copiez ces deux valeurs depuis Supabase : Project Settings > API
# (voir SETUP.md). Ne mettez jamais la clé "service_role" dans ces deux lignes.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Envoi des e-mails (étape 4). À définir uniquement dans Vercel, jamais sur GitHub.
# Clé secrète créée sur resend.com (API Keys, droit "Sending access").
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Facultatif : adresse d'expédition d'un domaine vérifié chez Resend.
# Sans cette ligne, l'adresse de test de Resend est utilisée (envoi limité à votre propre adresse).
MAIL_FROM_ADDRESS=relances@votre-domaine.fr

# Récapitulatif quotidien (étape 5). À définir uniquement dans Vercel, jamais sur GitHub.
# Clé "service_role" de Supabase (Project Settings > API Keys). Secrète, serveur uniquement.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role
# Mot de passe de la tâche planifiée : une longue suite de caractères au hasard (32 minimum).
CRON_SECRET=une-longue-suite-de-caracteres-au-hasard
# Facultatif : adresse du site dans les liens des e-mails.
APP_URL=https://www.collectflow.fr
